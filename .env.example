# Copy to .env.local and fill in. Never commit .env.local.

# Your myshopify domain, without protocol or trailing slash.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# Storefront API access token.
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps ->
# create an app -> Configuration -> Storefront API -> install, then copy the
# Storefront API access token. This token is public-scoped and read-only for
# the catalog, but keep it server-side anyway so it can be rotated freely.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Storefront API version (Shopify ships one each quarter). Pin it explicitly.
SHOPIFY_API_VERSION="2026-07"

# Shared secret for the catalog revalidation webhook at
# /api/webhooks/shopify. Shopify shows this when you create the webhook
# subscription in Settings -> Notifications -> Webhooks.
SHOPIFY_WEBHOOK_SECRET=""

# Public site URL, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
