# Copy to .env.local and fill in. Never commit .env.local.

# Your myshopify domain, without protocol or trailing slash.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# Storefront API access token.
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps ->
# create an app -> Configuration -> Storefront API -> install, then copy the
# Storefront API access token. This token is public-scoped and read-only for
# the catalog, but keep it server-side anyway so it can be rotated freely.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Storefront API version (Shopify ships one each quarter). Pin it explicitly.
SHOPIFY_API_VERSION="2026-07"

# Shared secret for the catalog revalidation webhook at
# /api/webhooks/shopify. Shopify shows this when you create the webhook
# subscription in Settings -> Notifications -> Webhooks.
SHOPIFY_WEBHOOK_SECRET=""

# Public site URL, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public Storefront API token for browser-side requests (useShopifyCookies / tracking).
# Shopify Admin -> Sales channels -> Headless -> [your storefront] ->
# Manage API access -> Storefront API -> public access token.
# This is NOT the same as the private token above; it is safe to expose in
# client-side JS and is required for Shopify Live View attribution.
NEXT_PUBLIC_SHOPIFY_PUBLIC_STOREFRONT_TOKEN=""

# Storefront ID used in Shopify Analytics / Monorail payloads.
# Shopify Admin -> Sales channels -> Headless -> [your storefront] ->
# Manage API access -> copy the numeric Storefront ID.
# Leaving this blank or "0" disables Shopify Analytics entirely at runtime.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID=""
